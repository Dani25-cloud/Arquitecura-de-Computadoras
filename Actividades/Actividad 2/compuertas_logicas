module compuertas_logicas (
	
	input A,
	input B,
	output AND,
	output OR,
	output NAND,
	output NOR,
	output XOR,
	output XNOR,
	output NOT
);

assign AND = A & B;

assign OR = A|B	;

assign NAND = ~(A & B);

assign NOR= ~( A | B );

assign XOR = A ^ B;

assign XNOR = ~(A^B);

assign NOT = ~A;

endmodule
